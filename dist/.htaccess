Options -Indexes
ServerSignature Off
FileETag None

<IfModule mod_headers.c>
    Header set X-Frame-Options "SAMEORIGIN"
    Header set X-Content-Type-Options "nosniff"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
    Header set Permissions-Policy "camera=(), microphone=(), geolocation=()"
    Header set X-XSS-Protection "1; mode=block"
    Header set Content-Security-Policy "default-src 'self'; base-uri 'self'; form-action 'self' https://calendly.com
    https://wa.me; frame-ancestors 'none'; frame-src 'self' https://calendly.com https://*.calendly.com; img-src 'self'
    data: https: blob:; script-src 'self' 'unsafe-inline' https://assets.calendly.com https://cdnjs.cloudflare.com;
    style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://cdnjs.cloudflare.com; font-src 'self'
    https://fonts.gstatic.com https://cdnjs.cloudflare.com data:; connect-src 'self' https://*.calendly.com
    https://wa.me; object-src 'none'; upgrade-insecure-requests;"
</IfModule>

<FilesMatch "\.(env|ini|log|sql|bak|old)$">
    Require all denied
</FilesMatch>

<FilesMatch "^\.(htaccess|htpasswd|git|svn|DS_Store)$">
    Require all denied
</FilesMatch>